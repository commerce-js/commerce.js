shamefully-hoist=false
strict-peer-dependencies=false

# @prisma/client is an undeclared implicit peer of @commercejs/platform:
# its Prisma-generated client (packages/platform/dist/.../generated/internal/class.js)
# does `import * as runtime from "@prisma/client/runtime/client"` without the package
# declaring @prisma/client as a dep. Consumers like apps/dashboard list it themselves
# and their bundlers (Nuxt/Vite) resolve it at build-time, so this never surfaced there.
#
# Unbundled runtimes — e.g. `tsx scripts/seed-merchant.ts` — hit Node's raw resolver
# from packages/platform/dist/... and fail. Hoisting @prisma/client to the workspace
# root makes Node's upward resolution find it from any workspace package.
#
# Proper fix would be declaring @prisma/client in packages/platform/package.json, but
# that currently drags the generated-client type-check from 7.4 → 7.7 and exposes
# latent nullable-Json input-type errors in profiles.ts. Hoist now, fix types later.
public-hoist-pattern[]=@prisma/client
