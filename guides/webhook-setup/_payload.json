: true }\n})\n","server/api/webhooks/tap-payment.post.ts","ts",[174,400,401,427,453,457,479,490,515,523,527,559,582,600,604,610,640,664,705,711,716,722,745,765,770,776,790,807,824,871,888,905,916,933,941,946,966],{"__ignoreMap":172},[177,402,403,407,410,413,416,419,422,424],{"class":179,"line":180},[177,404,406],{"class":405},"s7zQu","import",[177,408,409],{"class":253}," {",[177,411,412],{"class":250}," WebhookVerifier",[177,414,415],{"class":253}," }",[177,417,418],{"class":405}," from",[177,420,421],{"class":253}," '",[177,423,62],{"class":187},[177,425,426],{"class":253},"'\n",[177,428,429,431,433,436,439,442,444,446,448,451],{"class":179,"line":191},[177,430,406],{"class":405},[177,432,409],{"class":253},[177,434,435],{"class":250}," tap",[177,437,438],{"class":405}," as",[177,440,441],{"class":250}," tapConfig",[177,443,415],{"class":253},[177,445,418],{"class":405},[177,447,421],{"class":253},[177,449,450],{"class":187},"@commercejs/webhook-verifier/configs",[177,452,426],{"class":253},[177,454,455],{"class":179,"line":289},[177,456,311],{"emptyLinePlaceholder":310},[177,458,459,463,466,468,471,473,476],{"class":179,"line":295},[177,460,462],{"class":461},"spNyl","const",[177,464,465],{"class":250}," verifier ",[177,467,254],{"class":253},[177,469,470],{"class":253}," new",[177,472,412],{"class":183},[177,474,475],{"class":250},"(",[177,477,478],{"class":253},"{\n",[177,480,481,484,487],{"class":179,"line":301},[177,482,483],{"class":253},"  ...",[177,485,486],{"class":250},"tapConfig",[177,488,489],{"class":253},",\n",[177,491,492,496,499,502,504,507,509,512],{"class":179,"line":307},[177,493,495],{"class":494},"swJcz","  secretKey",[177,497,498],{"class":253},":",[177,500,501],{"class":250}," process",[177,503,228],{"class":253},[177,505,506],{"class":250},"env",[177,508,228],{"class":253},[177,510,511],{"class":250},"TAP_SECRET_KEY",[177,513,514],{"class":253},"!,\n",[177,516,517,520],{"class":179,"line":314},[177,518,519],{"class":253},"}",[177,521,522],{