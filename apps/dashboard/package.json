{
  "name": "@commercejs/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "CommerceJS Cloud Dashboard — manage stores, deploys, and billing",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && pnpm build:worker",
    "build:worker": "esbuild worker.ts --bundle --platform=node --format=esm --target=node22 --outfile=.output/worker.mjs --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);' --packages=external",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@commercejs/notification-smtp": "workspace:*",
    "@commercejs/platform": "workspace:*",
    "@commercejs/storage-s3": "workspace:*",
    "@commercejs/types": "workspace:*",
    "@nuxt/ui": "^4.4.0",
    "@prisma/adapter-neon": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@vueuse/core": "^14.2.0",
    "bcrypt-ts": "^5.0.3",
    "bullmq": "^5.40.0",
    "ioredis": "^5.4.2",
    "lru-cache": "^11.2.5",
    "nuxt": "^4.3.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.89",
    "esbuild": "^0.24.0",
    "h3": "^1.15.4",
    "prisma": "^7.6.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
