# CommerceJS Cloud — dashboard/worker environment
# Local dev: copy to apps/dashboard/.env (or use the monorepo-root .secrets file —
# prisma.config.ts and start scripts load both, app-local wins).
# Production: set these as Fly secrets (`fly secrets set KEY=value`).

# --- Control DB (Neon project: cjs-control; pooled connection string) ---
NEON_CONTROL_DB_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb

# --- Neon API (merchant DB provisioning — one project per merchant) ---
NEON_API_KEY=

# --- BullMQ / Redis (Upstash: use the rediss:// URL) ---
REDIS_URL=redis://localhost:6379

# --- Sessions (dashboard operators, merchant staff, buyers; 32+ chars) ---
NUXT_SESSION_PASSWORD=

# --- Tenant resolution base host (merchant subdomains resolve under this) ---
COMMERCEJS_BASE_HOST=commercejs.cloud

# --- Media uploads (Fly Tigris — native env names; any S3 works) ---
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=

# --- Co-supervised processes (scripts/start-web.sh; defaults shown) ---
STOREFRONT_PORT=3001
CHECKOUT_PORT=3002
