// ---------------------------------------------------------------------------
// PasswordReset model — short-lived tokens for admin + buyer reset flows
// ---------------------------------------------------------------------------
//
// Single table, `actorType` discriminates 'admin' | 'buyer'; `actorId`
// references admin_users.id or customers.id respectively (FK enforced
// in the domain layer, not at the DB level since PG doesn't support
// polymorphic FKs without a CHECK per target row). Tokens are stored
// as sha256(raw) — the raw exists only in the email URL + the accept
// request body. Single-use via `used_at IS NULL` predicate on the
// consumption UPDATE. Expiry window: 1 hour (tunable in the domain
// layer).
// ---------------------------------------------------------------------------

model PasswordReset {
  id            String    @id @default(uuid())
  actorType     String    @map("actor_type") // 'admin' | 'buyer'
  actorId       String    @map("actor_id")
  tokenHash     String    @unique @map("token_hash")
  emailSnapshot String    @map("email_snapshot")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([actorType, actorId])
  @@map("password_resets")
}
