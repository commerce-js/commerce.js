{
  "name": "@commercejs/platform",
  "version": "0.5.1",
  "description": "Native commerce engine — own your data, implement CommerceAdapter without external platforms",
  "repository": {
    "type": "git",
    "url": "https://github.com/commerce-js/commerce.js.git",
    "directory": "packages/platform"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./neon": {
      "types": "./dist/database/neon/index.d.ts",
      "import": "./dist/database/neon/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:seed": "node scripts/migrate.mjs --seed"
  },
  "dependencies": {
    "@commercejs/types": "workspace:*",
    "bcrypt-ts": "^5.0.0",
    "drizzle-orm": "^0.38.4"
  },
  "peerDependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "peerDependenciesMeta": {
    "@neondatabase/serverless": {
      "optional": true
    }
  },
  "devDependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-kit": "^0.30.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
