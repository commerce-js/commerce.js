{
  "name": "@commercejs/nuxt",
  "version": "0.6.23",
  "description": "CommerceJS Nuxt module — composables, plugin, and auto-generated REST API",
  "repository": {
    "type": "git",
    "url": "https://github.com/commerce-js/commerce.js.git",
    "directory": "packages/nuxt"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "import": "./dist/runtime/*"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build && node scripts/fix-esm-extensions.mjs",
    "dev": "nuxi dev playground",
    "typecheck": "nuxt-module-build build",
    "clean": "rm -rf dist .nuxt"
  },
  "dependencies": {
    "@commercejs/adapter-salla": "workspace:*",
    "@commercejs/platform": "workspace:*",
    "@commercejs/types": "workspace:*",
    "@vueuse/core": "^14.2.0",
    "consola": "^3.4.2",
    "h3": "^1.13.0",
    "nuxt-auth-utils": "^0.5.29",
    "ulid": "^3.0.2",
    "unwasm": "^0.5.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.3.1",
    "@nuxt/module-builder": "^0.8.0",
    "@nuxt/schema": "^4.3.1",
    "nuxt": "^4.3.1",
    "typescript": "^5.7.0"
  }
}
