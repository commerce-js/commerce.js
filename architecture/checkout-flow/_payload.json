ronous results, the ",[133,531,532],{},"handleWebhookUpdate()"," method can transition the session directly from any non-terminal state:",[142,535,537],{"className":253,"code":536,"language":255,"meta":147,"style":147},"session.handleWebhookUpdate(paymentSession)\n// Forces to 'complete' or 'failed' based on status\n",[133,538,539,551],{"__ignoreMap":147},[151,540,541,543,545,548],{"class":153,"line":154},[151,542,263],{"class":262},[151,544,267],{"class":266},[151,546,547],{"class":270},"handleWebhookUpdate",[151,549,550],{"class":262},"(paymentSession)\n",[151,552,553],{"class":153,"line":160},[151,554,555],{"class":359},"// Forces to 'complete' or 'failed' based on status\n",[137,557,559],{"id":558},"sync-on-return-vs-webhook","Sync-on-Return vs Webhook",[129,561,562],{},"CommerceJS uses a dual strategy for payment confirmation:",[564,565,566,582],"table",{},[567,568,569],"thead",{},[570,571,572,576,579],"tr",{},[573,574,575],"th",{},"Method",[573,577,578],{},"When",[573,580,581],{},"How",[583,584,585,603],"tbody",{},[570,586,587,594,597],{},[588,589,590],"td",{},[591,592,593],"strong",{},"Sync-on-Return",[588,595,596],{},"Customer redirected back",[588,598,599,602],{},[133,600,601],{},"confirmPayment()"," calls provider to verify",[570,604,605,610,613],{},[588,606,607],{},[591,608,609],{},"Webhook",[588,611,612],{},"Async notification from provider",[588,614,615,617],{},[133,616,532],{}," updates session",[129,619,620],{},"The webhook acts as a safety net. If the customer closes their browser during 3DS, or the redirect fails, the webhook still updates the session.",[137,622,624],{"id":623},"events","Events",[129,626,131,627,629,630,633],{},[133,628,109],{}," extends ",[133,631,632],{},"EventEmitter"," and fires events at key transitions:",[142,635,637],{"className":253,"code":636,"language":255,"meta":147,"style":147},"session.on('stateChange', ({ from, to }) => {\n  console.log(`Checkout: ${from} → ${to}`)\n})\n\nsession.on('complete', ({ paymentSession }) => 