288],{"class":266},[151,341,342],{"class":291},"+97312345678",[151,344,295],{"class":266},[151,346,298],{"class":266},[151,348,349,352],{"class":153,"line":184},[151,350,351],{"class":266},"}",[151,353,354],{"class":262},")\n",[151,356,357],{"class":153,"line":190},[151,358,360],{"class":359},"sHwdD","// session.state === 'info'\n",[232,362,364],{"id":363},"shipping-address-info-shipping","Shipping Address (info → shipping)",[129,366,367,368,371],{},"Providing a shipping address moves the session to ",[133,369,370],{},"shipping",". You can optionally set a separate billing address:",[142,373,375],{"className":253,"code":374,"language":255,"meta":147,"style":147},"session.setShippingAddress(shippingAddress, billingAddress)\n// session.state === 'shipping'\n",[133,376,377,395],{"__ignoreMap":147},[151,378,379,381,383,386,389,392],{"class":153,"line":154},[151,380,263],{"class":262},[151,382,267],{"class":266},[151,384,385],{"class":270},"setShippingAddress",[151,387,388],{"class":262},"(shippingAddress",[151,390,391],{"class":266},",",[151,393,394],{"class":262}," billingAddress)\n",[151,396,397],{"class":153,"line":160},[151,398,399],{"class":359},"// session.state === 'shipping'\n",[232,401,403],{"id":402},"payment-submission-shipping-payment","Payment Submission (shipping → payment)",[129,405,406,407,410,411,414],{},"Calling ",[133,408,409],{},"submitPayment()"," creates a payment session with the provider. The session transitions to ",[133,412,413],{},"payment"," while awaiting the result:",[142,416,418],{"className":253,"code":417,"language":255,"meta":147,"style":147},"const paymentSession = await session.submitPayment({\n  sourceToken: 'tok_xxx',\n})\n// session.state === 'payment'\n// paymentSession.redirectUrl → 3DS URL (if required)\n",[133,419,420,448,464,470,475],{"__ignoreMap":147},[151,421,422,426,429,432,436,439,441,444,446],{"class":153,"line":154},[151,423,425],{"class":424},"spNyl","const",[151,427,428],{"class":262}," paymentSession ",[151,430,431],